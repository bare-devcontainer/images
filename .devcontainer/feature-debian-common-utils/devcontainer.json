{
  // Baseline check: every image extends debian, so a feature that works here is
  // expected to work everywhere unless a child image overlaps with it.
  "name": "feature-debian-common-utils",
  // Features are verified against the published image, which is what consumers
  // layer them onto. Renovate refreshes the digest as images are published.
  "image": "ghcr.io/bare-devcontainer/debian:trixie@sha256:709adc59c1bd061e416d33119aad002fd361b4058a845543d9ddc4fac762dd48",
  "features": {
    // Options are left at their upstream defaults so the check exercises what a
    // consumer gets. In particular `username` stays "automatic", which is what
    // makes this a test of the feature adopting the image's existing dev user.
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges"
  ],
  "remoteUser": "dev"
}
