{
  // Baseline check: every image extends debian, so a feature that works here is
  // expected to work everywhere unless a child image overlaps with it.
  "name": "feature-debian-git-lfs",
  "image": "ghcr.io/bare-devcontainer/debian:trixie",
  "features": {
    // Defaults install from a third-party apt repository and register Git LFS
    // through a postCreateCommand, so this covers the only feature under test
    // that also does work at container start.
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges"
  ],
  "remoteUser": "dev"
}
